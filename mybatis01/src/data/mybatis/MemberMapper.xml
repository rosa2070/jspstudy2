<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="data.mybatis.MemberMapper">
	<insert id="join" parameterType="test.dto.Member">
		insert into member
		values (#{userid}, #{pwd}, #{email}, sysdate)
	</insert>
	<delete id="remove" parameterType="String">
		delete from member where userid=#{userid}
	</delete>
	<update id="edit" parameterType="test.dto.Member">
		update member
		set pwd=#{pwd}, email=#{email}
		where userid=#{userid}
	</update>
	<select id="selectAll" resultType="test.dto.Member">
		select * from member
	</select>
	<select id="getinfo" resultType="test.dto.Member" parameterType="String">
		select * from member where userid=#{userid}
	</select>
</mapper>